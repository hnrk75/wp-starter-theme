parameters:
    level: 5
    # Only this project's code; the shared packages are analyzed in their own repos.
    paths:
        - web/app/themes/wp-starter-child
        - web/app/mu-plugins
    excludePaths:
        # Subfolders in mu-plugins are installed by Composer.
        - web/app/mu-plugins/*/*
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanDirectories:
        - web/wp/wp-includes
        - web/wp/wp-admin/includes
    ignoreErrors:
        # Standard WordPress loop: have_posts() is impure — PHPStan cannot infer side effects.
        - message: '#While loop condition is always true\.#'
          reportUnmatched: false
        - message: '#Unreachable statement - code above always terminates\.#'
          reportUnmatched: false
