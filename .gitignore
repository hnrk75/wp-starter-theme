# ───── Application (wp-content) ────────────────────────────────
web/app/mu-plugins/*/
!web/app/mu-plugins/.gitkeep

web/app/plugins/*
!web/app/plugins/.gitkeep

web/app/upgrade
web/app/upgrade-temp-backup
web/app/cache/*

# Uploads — ignore actual files but keep directory structure
web/app/uploads/*
!web/app/uploads/.gitkeep
!web/app/uploads/fonts/
!web/app/uploads/fonts/.gitkeep

# Ignore default WordPress themes
web/app/themes/twenty*/

# Theme language files (often generated externally)
web/app/themes/*/languages/*
!web/app/themes/*/languages/.gitkeep

# ───── WordPress Core ──────────────────────────────────────────
web/wp
web/.htaccess
web/.user.ini

# ───── WordPress language files (downloaded automatically) ─────
web/app/languages/*
!web/app/languages/.gitkeep

# ───── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───── Backup and Temporary Files ──────────────────────────────
*.bak
*.old
*.tmp
*~
*.swp
*.swo

# ───── Database Dumps ──────────────────────────────────────────
*.sql
*.sql.gz
*.sql.zip

# ───── Dotenv ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ───── Composer auth (contains license keys) ──────────────────
auth.json

# ───── Composer ────────────────────────────────────────────────
/vendor
composer.phar
!composer.lock                 # commit the lock file

# ───── WP-CLI ──────────────────────────────────────────────────
wp-cli.local.yml

# ───── Node / Build ────────────────────────────────────────────
node_modules/
.vite/
.turbo/
.esbuild/
.parcel-cache/
.cache/
tmp/
.sass-cache/

# ───── OS Files ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ───── Editor / IDE Files ──────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml

# ───── Claude Code (local settings) ───────────────────────────
.claude/
memory/

# ───── Tooling configs (committed for consistent setup) ────────
# These files are NOT ignored — listed here for documentation only:
# phpcs.xml, phpstan.neon, .eslintrc.*, .stylelintrc.*, .prettierrc.*,
# package.json, package-lock.json, postcss.config.*, tailwind.config.*

# ───── PHPStan ─────────────────────────────────────────────────
.phpstan/
.phpstan.cache/
phpstan.neon.local
var/phpstan/
var/phpstan/**

# ───── PHPCS cache ─────────────────────────────────────────────
.phpcs.cache

# ───── PHPUnit ──────────────────────────────────────────────────
.phpunit.result.cache

# ───── ESLint / Stylelint / Prettier caches ───────────────────
.eslintcache
.stylelintcache
.prettier-cache
web/app/themes/**/.eslintcache
web/app/themes/**/.stylelintcache

# ───── Build artifacts (themes) — JS/CSS/ZIP/Maps ─────────────
# JS bundles, sourcemaps and rev-manifest
web/app/themes/**/assets/js/dist/**
web/app/themes/**/rev-manifest.json

# Compiled/minified CSS output (not source files)
web/app/themes/**/assets/css/*.min.css
web/app/themes/**/assets/css/*.min.css.map
web/app/themes/**/style.min.css
web/app/themes/**/style.min.css.map

# Critical CSS (if your critical-task writes to /css)
web/app/themes/**/css/**
!web/app/themes/**/css/.gitkeep

# All sourcemaps
**/*.map

# Packade releaser
web/app/themes/**/*.zip

# ───── Coverage / test output ─────────────────────────────────
coverage/
reports/
.nyc_output/

# ───── Alternative: commit built assets ───────────────────────
# To commit minified assets, comment out the relevant rules above
# for style.min.css and scripts.min.js, but keep ignoring *.map
# and rev-manifest.
#
# Example:
# # **/*.map
# # web/app/themes/**/rev-manifest.json
