{
  "name": "hnrk75/wp-starter-theme",
  "type": "project",
  "license": "MIT",
  "description": "Modern WordPress starter theme built on Bedrock with Composer, PHPCS/PHPStan and a Gulp-based build pipeline.",
  "homepage": "https://github.com/hnrk75/wp-starter-theme",
  "authors": [
    {
      "name": "Henrik Pettersson",
      "homepage": "https://github.com/hnrk75"
    }
  ],
  "keywords": [
    "bedrock",
    "wordpress",
    "starter-theme",
    "composer"
  ],
  "support": {
    "issues": "https://github.com/hnrk75/wp-starter-theme/issues"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    },
    {
      "type": "vcs",
      "url": "https://github.com/hnrk75/hnrk-cookie-concent"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer/installers": "^2.3",
    "vlucas/phpdotenv": "^5.6.1",
    "oscarotero/env": "^2.1.0",
    "roots/bedrock-autoloader": "^1.0.4",
    "roots/bedrock-disallow-indexing": "^2.0.0",
    "roots/wordpress": "7.1",
    "roots/wp-config": "^1.0",
    "wpackagist-theme/twentytwentyfive": "1.5",
    "wpengine/advanced-custom-fields-pro": "6.8.9",
    "hnrk/cookie-consent": "1.0.0",
    "wpackagist-plugin/ai-provider-for-anthropic": "1.0.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-cli/wp-cli-bundle": "^2.11",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "phpcs -p -s -d memory_limit=512M --standard=phpcs.xml",
    "lint:fix": "phpcbf -p -d memory_limit=512M --standard=phpcs.xml",
    "analyze": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "analyze:baseline": "phpstan analyse -c phpstan.neon --generate-baseline",
    "test": [
      "@lint",
      "@analyze"
    ],
    "post-root-package-install": [
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}
